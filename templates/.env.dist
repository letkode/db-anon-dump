# .env -- secrets for dbanondump. Read automatically from the same folder as config.yaml.
# NEVER commit it (it is in .gitignore). Keep it private:   chmod 600 .env
#
# Files are merged in this order (a later one overrides the earlier ones):
#     .env  <  .env.local  <  .env.<APP_ENV>  <  .env.<APP_ENV>.local
# APP_ENV comes from the real environment or from .env / .env.local. Without it only .env and .env.local
# are read. A variable already set in the real environment (export ...) ALWAYS wins over every file.

# Password of the source database account (config.yaml: source.password_env names this variable).
# Use SINGLE quotes: inside double quotes or without quotes a "$" starts a variable expansion.
DBANONDUMP_SOURCE_PASSWORD=''

# APP_ENV=dev
