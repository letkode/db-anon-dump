# config.yaml -- main settings of dbanondump.
#
#   dbanondump init                         (writes config.yaml, columns.yaml, functions.yaml and .env)
#   dbanondump validate -c config.yaml      # offline lint of the three files
#   dbanondump check    -c config.yaml      # validate against the real structure, list unreviewed columns
#   dbanondump run      -c config.yaml      # extract, anonymise, write the dump
#
# Relative paths are resolved against the folder of this file.

version: 1

# One project = one engine. Patterns in columns.yaml are written in that engine's own SQL.
engine: mysql               # mysql | mariadb | postgres

# Where the data comes from. Use a READ-ONLY account, ideally on a replica: the tool only reads.
# The password is NEVER written here: put it in the .env file next to this one (written by `dbanondump init`)
#     DBANONDUMP_SOURCE_PASSWORD='...'
# or export it as an environment variable (a variable already exported wins over the .env files).
source:
  host: replica.internal
  port: 3306                # default: 3306 (5432 for postgres)
  user: readonly
  database: myapp
  # password_env: DBANONDUMP_SOURCE_PASSWORD   # name of the environment variable that holds the password
  # container_host: host.docker.internal       # the source's host as seen from the temporary container
  #                                            # (needed when the source runs on THIS machine)
  # dump_file: ./prod.sql.gz                   # alternative: import an existing dump instead of connecting

# The throwaway database where the data is anonymised. It is removed at the end, even on errors.
temp:
  image: mysql:8.0.32       # same major version as the source (default: the engine's usual image)
  # database: anon_tmp
  # tmpfs: true             # keep its data in RAM: faster, uses memory
  # extra_args: ["--innodb-buffer-pool-size=2G"]

# Where the dump is written. A ".gz" suffix compresses it.
#   {datetime} -> 20261118-153045   (so two runs on the same day never overwrite each other)
#   {date}     -> 2026-11-18
output: output/dev-dump-{datetime}.sql.gz

# Run log: one file per `run` / `check`, logs/<command>-<datetime>.log, with everything printed on screen
# (with the time), the error if it fails, and a summary with the total duration and the time of each phase.
# It can quote fragments of real data in SQL errors, so it is created with mode 0600 and logs/ is in .gitignore.
# logs:
#   dir: logs               # relative to this file; "" = do not write logs (default: logs)
#   keep: 30                # keep only the newest N log files (default 0 = keep all)

# Audit: which columns `check` and `run` report as "looks personal" when columns.yaml gives them no pattern.
# This section REPLACES the built-in lists, so it is shown here in full: translate it, add your own column
# names, remove what does not apply. Delete the whole section to use the built-in lists.
audit:
  names:                   # case-insensitive regular expressions, matched against the COLUMN name
    - mail
    - phone
    - fono
    - celular
    - rut
    - dni
    - passport
    - pasaporte
    - name
    - nombre
    - apellido
    - address
    - direccion
    - birth
    - nacimiento
    - ^ip$
    - ip_address
    - token
    - password
    - secret
    - salt
    - linkedin
    - identification
  types:                   # data types (as the database reports them) that may hold anything
    - json
    - longtext
    - mediumtext
    - text
    - tinytext

# Which tables to extract. A spec is a name, a glob (user_*) or * for all. Excludes always win.
tables:
  include: ["*"]
  exclude: [mail_log, audit_*]      # NOT in the dump at all (not even the structure)
  # schema_only: [job_queue, app_request]   # in the dump with their structure, but WITHOUT rows
  #                                         # [] or absent = every table carries its data; ["*"] = structure only
  #                                         # (also: --schema-only 'job_queue,app_*' on the command line, added to this list)

# The other two files. Both are optional here: the defaults are the files below, next to this one
# (columns.yaml must exist; functions.yaml is used only if it exists).
columns: columns.yaml
functions: functions.yaml
